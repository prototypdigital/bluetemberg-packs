{
  "name": "bluetemberg-rules",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "bluetemberg sync --silent || true",
    "validate": "node .github/scripts/validate-packs.cjs",
    "scan": "bluetemberg scan packages/*",
    "generate:catalog": "node scripts/generate-catalog.js",
    "build:site": "node scripts/build-site.js",
    "build:og": "node scripts/build-og.js",
    "lint:md": "markdownlint \"packages/**/llm/**/*.md\""
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "bluetemberg": "^0.20.0",
    "markdownlint-cli": "^0.49.1"
  }
}
